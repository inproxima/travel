# Copy this file to `.env` and paste your key below:
#   cp .env.example .env
# `.env` is gitignored, so your key never gets committed.

# Required. Get it at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Search defaults (Google `gl` country, `hl` language, price currency)
DEFAULT_COUNTRY=us
DEFAULT_LANGUAGE=en
DEFAULT_CURRENCY=USD

# Budget guard: most SerpApi calls one dashboard search may make.
# A basic search across the 4 cabins costs 4 calls.
MAX_CALLS_PER_SEARCH=20

# Reuse identical searches for this many minutes instead of calling SerpApi again
CACHE_TTL_MINUTES=60

# Optional, phase 4: real award (points) availability through the seats.aero Partner API.
# Leave empty to use points *estimates* only.
SEATS_AERO_API_KEY=
