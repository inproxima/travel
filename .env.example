# Copy this file to `.env` and fill in your keys (./run.sh does the copy for you).
# `.env` is gitignored, so your keys never get committed.

# --- SerpApi (required): flights, hotels, reviews, maps, forums
# Get it at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# --- OpenAI (for the AI Planner)
# Get it at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# One of: low, medium, high, xhigh, max (which ones work depends on the model)
OPENAI_REASONING_EFFORT=medium

# --- seats.aero (optional): real award seats for points flights.
# Needs a seats.aero Pro subscription; personal use only.
# Leave empty to get points estimates from cash fares instead.
SEATS_AERO_API_KEY=

# --- Defaults (also editable in Settings)
DEFAULT_COUNTRY=us
DEFAULT_LANGUAGE=en
DEFAULT_CURRENCY=USD

# --- Credit guards
# Most SerpApi credits one Flights or Hotels action may use
MAX_CALLS_PER_SEARCH=20
# Most SerpApi credits one AI Planner question may use
AI_MAX_SERPAPI_CALLS=40
# Identical searches within this many minutes are answered from the local cache (free)
CACHE_TTL_MINUTES=60

PORT=3000
